# Production / AWS RDS Environment Configuration Template
DATABASE_URL=postgresql+asyncpg://postgres:YourSecurePassword@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/clinicflow
SECRET_KEY=generate-a-strong-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=production
MOCK_SES=false
AWS_REGION=us-east-1
SES_SENDER_EMAIL=reminders@clinicflow.med
CORS_ORIGINS=["https://clinicflow.med"]
